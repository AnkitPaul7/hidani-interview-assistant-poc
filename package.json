{
  "name": "hidani-interview-assistant-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Interview Assistant POC (Audio -> Deepgram STT -> Question Detection -> OpenAI Streaming Answer -> 3-Panel UI)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,WEB\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace=@hidani/server",
    "dev:web": "npm run dev --workspace=@hidani/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@hidani/server",
    "start:server": "npm run start --workspace=@hidani/server",
    "start:web": "npm run start --workspace=@hidani/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "deepgram",
    "openai",
    "realtime",
    "stt",
    "streaming",
    "interview-assistant",
    "websockets",
    "nextjs"
  ],
  "author": "Ankit Paul",
  "license": "MIT"
}
