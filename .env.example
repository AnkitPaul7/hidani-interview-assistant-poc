# ==============================================================================
# Real-Time Interview Assistant POC - Environment Configuration
# ==============================================================================

# Node / Backend Configuration
PORT=8080
NODE_ENV=development

# Deepgram Live Speech-to-Text API Key
# Sign up at https://console.deepgram.com for free $200 credits
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key (GPT-4o-mini for streaming answers & classification)
# Sign up at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Groq API Key (if opting for ultra-low TTFT Llama 3.3 streaming)
GROQ_API_KEY=

# Audio Pipeline Tuning
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
ENDPOINTING_MS=500
UTTERANCE_END_MS=1000

# Frontend Configuration
NEXT_PUBLIC_WS_URL=ws://localhost:8080
